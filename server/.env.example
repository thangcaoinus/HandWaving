# ==============================================
# HandWaving Server Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to git!

# ----------------------------------------------
# Database Connection
# ----------------------------------------------
# Format: postgresql://username:password@host:port/database_name
#
# Development: Use localhost PostgreSQL
# Production options:
#   - Supabase: Get from https://supabase.com/dashboard/project/_/settings/database
#   - Railway: Get from Railway dashboard → PostgreSQL → Connect
#   - Render: Get from Render dashboard → PostgreSQL → Internal Connection String
#
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gesture_canvas"

# ----------------------------------------------
# JWT Authentication
# ----------------------------------------------
# Generate a SECURE random secret: openssl rand -hex 64
# CRITICAL: Use different secrets for dev/staging/production!
# NEVER reuse the same JWT_SECRET across environments!
#
JWT_SECRET="your-super-secret-jwt-key-generate-with-openssl-rand-hex-64"
JWT_EXPIRES_IN="7d"

# ----------------------------------------------
# Server Configuration
# ----------------------------------------------
# Port for Express server
PORT=3001

# Environment: "development" or "production"
# Affects: error verbosity, logging, CSP headers
NODE_ENV="development"

# ----------------------------------------------
# CORS Configuration
# ----------------------------------------------
# Allowed frontend origin for CORS
# Development: http://localhost:5173
# Production: https://your-app.vercel.app (or your frontend URL)
# IMPORTANT: Must match your deployed frontend URL exactly (no trailing slash)
#
CLIENT_URL="http://localhost:5173"
